OPENAI_API_KEY=

GOOGLE_PROJECT_ID=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_PRIVATE_KEY=
GOOGLE_CLIENT_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_AUTH_URI=
GOOGLE_TOKEN_URI=
GOOGLE_AUTH_PROVIDER_X509_CERT_URL=
GOOGLE_CLIENT_X509_CERT_URL=
GOOGLE_UNIVERSE_DOMAIN=

# email id (the calendar address or 'primary')
CALENDAR_ID=

# Notes:
# - Do NOT include trailing commas after values.
# - For the private key you can either provide `GOOGLE_PRIVATE_KEY` with escaped newlines
#   ("-----BEGIN...\n...\n-----END PRIVATE KEY-----") or the base64-encoded value in
#   `GOOGLE_PRIVATE_KEY_B64` (use whichever your deployment system prefers).
# - Make sure `GOOGLE_CLIENT_EMAIL` is the service account email and that the account
#   has been granted access to the target calendar (see README).
